        "$value": "0 0 0 1px oklch(0 0 0 / 0.12), 0 1px 2px -1px oklch(0 0 0 / 0.1), 0 2px 4px 0 oklch(0 0 0 / 0.06)",
        "$type": "shadow"
      },
      "sm": {
        "$value": "0 1px 3px oklch(0 0 0 / 0.1)",
        "$type": "shadow"
      },
      "lg": {
        "$value": "0 4px 12px oklch(0 0 0 / 0.2)",
        "$type": "shadow"
      }

      }
    },
    "easing": {
      "out": {
        "$value": "ease-out",
        "$type": "cubicBezier"
      }
    },
    "shadow": {
      "border": {
        "$value": "0 0 0 1px oklch(0 0 0 / 0.08), 0 1px 2px -1px oklch(0 0 0 / 0.08), 0 2px 4px 0 oklch(0 0 0 / 0.04)",

{
  "name": "ml-scratch",
  "version": "2.1.0",
  "private": true,
  "description": "用積木與節點拉線學機器學習：YOLO 物件偵測、圖片分類、文字分類、本機 LLM 對話",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",

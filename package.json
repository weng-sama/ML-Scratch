  "dependencies": {
    "blockly": "13.3.0",
    "chart.js": "4.5.1",
    "drawflow": "0.0.60"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.140",
    "electron": "44.5.1",
    "vite": "8.3.3"
  }
